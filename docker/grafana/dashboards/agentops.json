{
 "title": "Ordering - AgentOps",
 "uid": "ordering-agentops",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "tags": [
  "ordering",
  "agentops"
 ],
 "panels": [
  {
   "type": "row",
   "title": "Service health",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "collapsed": false
  },
  {
   "type": "stat",
   "title": "Requests / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(ordering_http_requests_total[5m]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "5xx ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 6,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(ordering_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(ordering_http_requests_total[5m])), 1e-9)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "LLM cost today (USD)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    }
   },
   "targets": [
    {
     "expr": "sum(increase(ordering_llm_cost_usd_total[24h]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Thread-cache hit ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 18,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "targets": [
    {
     "expr": "sum(rate(ordering_cache_events_total{event=\"hit\"}[15m])) / clamp_min(sum(rate(ordering_cache_events_total{event=~\"hit|miss\"}[15m])), 1e-9)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Request rate by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(ordering_http_requests_total[5m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p95 latency by route",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(ordering_http_request_seconds_bucket[5m])))",
     "legendFormat": "{{route}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "row",
   "title": "LLM gateway (3-provider routing)",
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "collapsed": false
  },
