# ---------------------------------------------------------------------------
# Ordering Agentic System - environment configuration
# Copy to .env:  cp .env.example .env
# Any secret below can instead be supplied as a file: set <NAME>_FILE=/run/secrets/<name>
# ---------------------------------------------------------------------------

ENV=local
LOG_LEVEL=INFO
AGENT_VERSION=1.0.0

# --- PostgreSQL -----------------------------------------------------------------
# Owner role: migrations + seeding + RAG ingestion only.
POSTGRES_USER=ordering
POSTGRES_PASSWORD=ordering
POSTGRES_DB=ordering
# Least-privilege role used by every service (RLS applies to it).
APP_DB_PASSWORD=app_password
# Host-side URLs (compose publishes Postgres on 55432 to avoid clashing with a local Postgres).
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:55432/ordering
DATABASE_ADMIN_URL=postgresql+psycopg://ordering:ordering@localhost:55432/ordering
REDIS_URL=redis://localhost:6379/0

# --- Auth ---------------------------------------------------------------------------
# CHANGE BOTH for anything other than local development (production refuses dev defaults).
JWT_SECRET=dev-only-change-me-user-token-secret-0123456789
SERVICE_JWT_SECRET=dev-only-change-me-service-token-secret-9876543210
JWT_ISSUER=ordering-idp
JWT_AUDIENCE=ordering-api
# Production: point at your OIDC IdP JWKS (RS256) and disable the dev token endpoint.
# JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
ENABLE_DEV_TOKEN_ENDPOINT=true

# --- LLM Gateway ------------------------------------------------------------------
# native  = in-house provider adapters (Claude -> OpenAI -> Gemini per route)
# litellm = forward to the LiteLLM proxy (docker compose --profile litellm)
LLM_BACKEND=native
# Set to "mock" to run fully offline with the deterministic mock provider (tests/demo).
LLM_PROVIDER_OVERRIDE=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LITELLM_API_KEY=sk-litellm-dev-master-key
TENANT_DAILY_BUDGET_USD=25

# --- RAG ------------------------------------------------------------------------------
# openai (default, 1536d via LLM gateway) | gemini (768d) | local (fastembed bge-small, 384d) | hashing (offline tests)
EMBEDDING_PROFILE=openai
RERANKER_ENABLED=true
RAG_MIN_RERANK_SCORE=0.2

# --- Memory & cache ------------------------------------------------------------------
THREAD_CACHE_TTL_S=1800
SHORT_TERM_WINDOW_TURNS=8
MEMORY_RETENTION_DAYS=180

# --- API gateway ----------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60

# --- Observability --------------------------------------------------------------------
OTEL_ENABLED=true

# --- Fault injection (never honoured in production) -----------------------------------
# e.g. payment:unavailable,notification:flaky
FAULT_INJECTION=

# --- Grafana ----------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
