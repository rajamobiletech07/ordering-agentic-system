# Runtime config for staging (merged into the ordering-config ConfigMap; changes roll the pods).
ENV=staging
LOG_LEVEL=INFO
# Staging keeps HS256 tokens so the in-cluster smoke test can mint them; the dev-token endpoint stays off.
JWT_ISSUER=ordering-idp
JWT_AUDIENCE=ordering-api
RATE_LIMIT_PER_MINUTE=120
TENANT_DAILY_BUDGET_USD=10
