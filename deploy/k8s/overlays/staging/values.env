# Infrastructure identifiers for staging, substituted into the rendered manifests by ../../render.sh.
# Regenerate from Terraform after `terraform apply`: deploy/gcp/scripts/write-values.sh staging
# Non-secret by design: secrets live only in Secret Manager.
PROJECT_ID=my-ordering-staging
REGION=europe-west2
GKE_CLUSTER=ordering-staging
IMAGE_REPO=europe-west2-docker.pkg.dev/my-ordering-staging/ordering/ordering-app
APP_HOST=ordering-staging.example.com
STATIC_IP_NAME=ordering-staging-ip
SECURITY_POLICY=ordering-staging-edge
SSL_POLICY=ordering-staging-tls
PRIVATE_SERVICES_CIDR=10.100.0.0/16
RAG_BUCKET=my-ordering-staging-ordering-rag-docs
AGENTOPS_BUCKET=my-ordering-staging-ordering-agentops
WIF_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/github/providers/github
DEPLOY_SERVICE_ACCOUNT=gh-deployer@my-ordering-staging.iam.gserviceaccount.com
TF_SERVICE_ACCOUNT=gh-terraform@my-ordering-staging.iam.gserviceaccount.com
