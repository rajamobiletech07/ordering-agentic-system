# Runtime config for production (merged into the ordering-config ConfigMap).
ENV=production
LOG_LEVEL=INFO
# User tokens come from your OIDC IdP (RS256/ES256 via JWKS). Tokens must carry tenant_id and roles claims.
JWT_ISSUER=https://idp.example.com/
JWT_AUDIENCE=ordering-api
JWT_JWKS_URL=https://idp.example.com/.well-known/jwks.json
RATE_LIMIT_PER_MINUTE=60
TENANT_DAILY_BUDGET_USD=25
