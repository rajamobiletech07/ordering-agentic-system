# Infrastructure identifiers for production, substituted into the rendered manifests by ../../render.sh.
# Regenerate from Terraform after `terraform apply`: deploy/gcp/scripts/write-values.sh production
PROJECT_ID=my-ordering-prod
REGION=europe-west2
GKE_CLUSTER=ordering-production
IMAGE_REPO=europe-west2-docker.pkg.dev/my-ordering-prod/ordering/ordering-app
APP_HOST=ordering.example.com
STATIC_IP_NAME=ordering-production-ip
SECURITY_POLICY=ordering-production-edge
SSL_POLICY=ordering-production-tls
PRIVATE_SERVICES_CIDR=10.100.0.0/16
RAG_BUCKET=my-ordering-prod-ordering-rag-docs
AGENTOPS_BUCKET=my-ordering-prod-ordering-agentops
WIF_PROVIDER=projects/000000000000/locations/global/workloadIdentityPools/github/providers/github
DEPLOY_SERVICE_ACCOUNT=gh-deployer@my-ordering-prod.iam.gserviceaccount.com
TF_SERVICE_ACCOUNT=gh-terraform@my-ordering-prod.iam.gserviceaccount.com
